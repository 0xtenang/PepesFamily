{
  "name": "dlmm-agent",
  "version": "1.0.0",
  "type": "module",
  "description": "Standalone wallet-triggered Meteora DLMM bot for Solana",
  "main": "index.js",
  "bin": {
    "meridian": "cli.js"
  },
  "scripts": {
    "setup": "node setup.js",
    "env:encrypt": "node scripts/envrypt.js encrypt",
    "start": "node index.js",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:restart": "pm2 restart meridian --update-env",
    "pm2:logs": "pm2 logs meridian --lines 100",
    "dev": "DRY_RUN=true node index.js",
    "test": "npm run test:syntax && npm run test:standalone && node --test test/cleanup.test.js test/pepes.test.js",
    "test:syntax": "node scripts/check-syntax.js",
    "postinstall": "node scripts/patch-anchor.js",
    "test:standalone": "node test/test-standalone.js"
  },
  "dependencies": {
    "@meteora-ag/dlmm": "1.9.4",
    "@privy-io/node": "^0.37.0",
    "@solana/web3.js": "^1.95.0",
    "bn.js": "^5.2.1",
    "bs58": "^5.0.0",
    "dotenv": "^17.3.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
